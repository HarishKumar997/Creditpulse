FROM apache/airflow:2.10.4-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/dbt \
    && /opt/dbt/bin/pip install --no-cache-dir dbt-core==1.8.8 dbt-postgres==1.8.2 \
    && printf '%s\n' \
        '#!/bin/bash' \
        'export PYTHONNOUSERSITE=1' \
        'export PYTHONPATH=/opt/dbt/lib/python3.11/site-packages' \
        'exec /usr/local/bin/python3.11 /opt/dbt/bin/dbt "$@"' \
        > /usr/local/bin/dbt \
    && chmod 755 /usr/local/bin/dbt
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
USER airflow
COPY requirements-airflow.txt /requirements-airflow.txt
RUN pip install --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.10.4/constraints-3.11.txt" \
    -r /requirements-airflow.txt
